# Public Supabase values only. Never expose a service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional: only used as an enquiry fallback when Supabase is not configured.
VITE_WEB3FORMS_ACCESS_KEY=

# Admin email notifications are configured as Supabase Edge Function secrets.
# See EMAIL_NOTIFICATION_SETUP.md. Never put RESEND_API_KEY in this Vite .env file.
